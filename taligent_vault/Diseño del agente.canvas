		{"id":"e_s3_s3_registro_s3_redacta","fromNode":"s3_registro","fromSide":"bottom","toNode":"s3_redacta","toSide":"top","color":"6","label":"hallazgos + C1…Cn"},
		{"id":"e_s3_s3_redacta_s3_pdf","fromNode":"s3_redacta","fromSide":"bottom","toNode":"s3_pdf","toSide":"top","color":"6","label":"texto + qué cifra y qué gráfico"},
		{"id":"e_s3_s3_pdf_salida","fromNode":"s3_pdf","fromSide":"left","toNode":"salida","toSide":"bottom","color":"6","label":"informe: PDF + el mismo registro"}
